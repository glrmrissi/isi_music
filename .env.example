SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Required at build time (see build.rs): Last.fm API credentials used for
# scrobbling. Get them at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_32_char_api_key_here_000000
LASTFM_API_SECRET=your_32_char_secret_here_0000

RUST_LOG=isi_music=debug
